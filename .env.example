# ---------------------------------------------------------------------------
# Git & GitHub Game — environment template
#
# Copy to `.env` for local development and fill in real values:
#   cp .env.example .env
#
# Never commit the real `.env` — it holds the verification signing secret.
# On your host (Vercel / Netlify / CI), set these as build environment
# variables/secrets in the dashboard instead.
# ---------------------------------------------------------------------------

# Public base URL of the deployed site (no trailing slash, no hash).
# Used as the canonical "main link" for certificate verification URLs and
# QR codes. Falls back to the current browser origin when empty.
# Example: https://git-course.mscmsit.in
VITE_SITE_URL=https://your-site.example.com

# Secret salt mixed into the SHA-256 signature of verification tokens.
# Must be identical between token generation and token verification.
# Changing it invalidates every previously issued certificate token.
VITE_VERIFICATION_SALT=change-me-to-a-long-random-string
